# Doxyfile template for Qt6 API extraction
# Used by scripts/generate_qt6_swift_module.sh to generate a Swift module map.
#
# Placeholders replaced at runtime:
#   @QT6_INPUT@          - space-separated list of Qt6 module header directories
#   @OUTPUT_DIRECTORY@   - directory to write Doxygen output (XML)
#   @QT6_VERSION@        - Qt6 version string (e.g. 6.4.2)

PROJECT_NAME           = "Qt6 API"
PROJECT_NUMBER         = @QT6_VERSION@
OUTPUT_DIRECTORY       = @OUTPUT_DIRECTORY@

# Input: Qt6 module header directories
INPUT                  = @QT6_INPUT@
RECURSIVE              = YES

# Extract all public API
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO

# Only generate XML (used by parse_doxygen_xml.py)
GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO

XML_PROGRAMLISTING     = NO
XML_NS_MEMB_FILE_SCOPE = NO

# Only process .h header files; skip private and generated headers
FILE_PATTERNS          = *.h
EXCLUDE_PATTERNS       = */private/* \
                         *_p.h \
                         *_p_p.h \
                         *_impl.h \
                         */qconfig*.h \
                         */qtcore_eval.h

# Qt-specific preprocessor macros so Doxygen can parse the headers cleanly
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = Q_OBJECT= \
                         Q_GADGET= \
                         Q_PROPERTY(x)= \
                         Q_SIGNALS=public: \
                         Q_SLOTS= \
                         Q_INVOKABLE= \
                         Q_DECL_NOEXCEPT=noexcept \
                         Q_DECL_FINAL=final \
                         Q_DECL_OVERRIDE=override \
                         Q_REQUIRED_RESULT= \
                         Q_DECL_DEPRECATED= \
                         QDOC_PROPERTY(x)= \
                         QT_DEPRECATED= \
                         "QT_DEPRECATED_X(x)=" \
                         "QT_DEPRECATED_SINCE(a,b)=0" \
                         "Q_DECLARE_FLAGS(flags,enum)=" \
                         "Q_DISABLE_COPY(Class)=" \
                         QT_BEGIN_NAMESPACE= \
                         QT_END_NAMESPACE= \
                         Q_CORE_EXPORT= \
                         Q_GUI_EXPORT= \
                         Q_WIDGETS_EXPORT= \
                         Q_NETWORK_EXPORT= \
                         Q_SQL_EXPORT= \
                         Q_XML_EXPORT= \
                         Q_DBUS_EXPORT= \
                         Q_CONCURRENT_EXPORT= \
                         Q_PRINTSUPPORT_EXPORT= \
                         Q_OPENGL_EXPORT= \
                         "Q_DECLARE_INTERFACE(IFace,IId)=" \
                         "Q_DECLARE_METATYPE(x)=" \
                         "QT_FORWARD_DECLARE_CLASS(x)=" \
                         "QT_FORWARD_DECLARE_STRUCT(x)="

# Suppress all output except errors
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
